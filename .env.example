# ==============================================================================
# AI Content Intelligence OS — Environment Configuration
# ==============================================================================

# --- AI Model Gateway (Required) ---
# Primary LLM provider for reasoning, intelligence extraction, copywriting, and visuals
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini
OPENROUTER_COPYWRITING_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_IMAGE_MODEL=bytedance-seed/seedream-5-0-lite

# --- Research & Scraping Services ---
# Self-hosted Firecrawl instance or cloud API (automatic local parser fallback if offline)
FIRECRAWL_BASE_URL=http://localhost:3002
FIRECRAWL_API_KEY=fc-dummy-key-for-local

# Agent Reach configuration
AGENT_REACH_BASE_URL=http://localhost:8080
AGENT_REACH_API_KEY=

# GitHub API (Optional but recommended for higher rate limits)
GITHUB_TOKEN=

# --- Platform Publishing Credentials (Optional for automated publishing) ---
# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# X (Twitter)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# --- System & Storage Settings ---
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_PATH=data/intelligence_os.db
LOGS_DIR=logs
OUTPUT_DIR=output
